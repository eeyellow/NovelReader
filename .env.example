# ==============================================================================
# Google OAuth 2.0 專案設定 (Google Cloud Console)
# ==============================================================================
# 1. 前往 Google Cloud Console (https://console.cloud.google.com/)
# 2. 建立或選擇專案，至「API 和服務」>「OAuth 同意畫面」
#    - 測試階段：可在「測試使用者」加入自己的 Google Email 進行測試
#    - 正式開放：點擊「發布應用程式 (Publish App)」即可讓所有外部使用者登入
# 3. 至「憑證」> 建立「OAuth 用戶端 ID」，應用程式類型選擇「網頁應用程式」
#    - 已授權的重新導向 URI 新增：
#      http://localhost:4000/api/auth/callback/google
#      https://你的網域名稱/api/auth/callback/google
# 4. 填入下方用戶端編號與密鑰：

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 供前端 Google One Tap 或 GIS SDK 使用（通常與 GOOGLE_CLIENT_ID 相同）
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 站點對外完整 URL（用於 OAuth 重新導向，生產環境部署如 https://novel.yourdomain.com）
APP_URL=http://localhost:4000

# ==============================================================================
# Session 加密金鑰
# ==============================================================================
# 可留空（系統會在 data/.auth_secret 自動產生持久安全金鑰），亦可手動指定隨機字串
AUTH_SECRET=
